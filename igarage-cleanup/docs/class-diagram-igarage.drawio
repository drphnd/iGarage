" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e1t" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="is rented in" style="endArrow=none;html=1;rounded=0;startArrow=none;edgeStyle=none;fontStyle=2;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"><mxPoint x="938" y="308" as="sourcePoint"/><mxPoint x="647.5" y="418" as="targetPoint"/><Array as="points"><mxPoint x="938" y="363.0"/><mxPoint x="647.5" y="363.0"/></Array></mxGeometry></mxCell><mxCell id="e2s" value="1" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e2t" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e2"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="is extended by" style="endArrow=none;html=1;rounded=0;startArrow=diamondThin;startFill=1;startSize=16;edgeStyle=none;fontStyle=2;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"><mxPoint x="436" y="498" as="sourcePoint"/><mxPoint x="266" y="498" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3s" value="1" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e3"><mxGeometry x="-0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e3t" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="is charged in" style="endArrow=none;html=1;rounded=0;startArrow=diamondThin;startFill=1;startSize=16;edgeStyle=none;fontStyle=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="718" y="498" as="sourcePoint"/><mxPoint x="888" y="498" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4s" value="1" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e4"><mxGeometry x="-0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e4t" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="notes" value="All six classes are Eloquent models (app/Models). User extends Authenticatable; the others extend Model.&lt;br&gt;Association = the child keeps a foreign key (RESTRICT on delete). Composition (◆) = the child cannot exist without its rent (CASCADE).&lt;br&gt;User → Rent is reached through Ride (hasManyThrough), so rents do not store user_id. Underlined methods are static.&lt;br&gt;Garage status and rent status are calculated by methods (statusOn, status), not stored in the database." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="896" width="1178" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>