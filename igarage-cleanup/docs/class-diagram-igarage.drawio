<mxfile host="app.diagrams.net"><diagram name="iGarage Class Diagram" id="class"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1258" pageHeight="986"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c0" value="&lt;div style=&quot;text-align:center;background:#e8eef7;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;extends Authenticatable&lt;/font&gt;&lt;br&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ id: int&lt;br&gt;+ name: string&lt;br&gt;+ email: string&lt;br&gt;+ password: string&lt;br&gt;+ role: string&lt;br&gt;+ nik: string&lt;br&gt;+ phone: string&lt;br&gt;+ verification_status: string&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ rides(): HasMany&lt;br&gt;+ rents(): HasManyThrough&lt;br&gt;+ isAdmin(): bool&lt;br&gt;+ isApproved(): bool&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="226" height="268" as="geometry"/></mxCell><mxCell id="c1" value="&lt;div style=&quot;text-align:center;background:#e8eef7;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;extends Model&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ride&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ id: int&lt;br&gt;+ user_id: int&lt;br&gt;+ type: string&lt;br&gt;+ plate_number: string&lt;br&gt;+ brand: string&lt;br&gt;+ model: string&lt;br&gt;+ battery_capacity_kwh: float&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ user(): BelongsTo&lt;br&gt;+ rents(): HasMany&lt;br&gt;+ isElectric(): bool&lt;br&gt;+ canParkIn(garageType): bool&lt;br&gt;&lt;u&gt;+ normalizePlate(plate): string&lt;/u&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="436" y="40" width="282" height="268" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;text-align:center;background:#e8eef7;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;extends Model&lt;/font&gt;&lt;br&gt;&lt;b&gt;Garage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ id: int&lt;br&gt;+ code: string&lt;br&gt;+ type: string&lt;br&gt;+ daily_price: int&lt;br&gt;+ price_per_kwh: int&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ rents(): HasMany&lt;br&gt;+ isElectric(): bool&lt;br&gt;+ monthlyPrice(): int&lt;br&gt;+ scopeAvailableBetween(start, end): Builder&lt;br&gt;+ statusOn(day): string&lt;br&gt;&lt;u&gt;+ lastNumber(type): int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ makeCode(type, number): string&lt;/u&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="888" y="40" width="330" height="268" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:center;background:#e8eef7;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;extends Model&lt;/font&gt;&lt;br&gt;&lt;b&gt;RentExtend&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ id: int&lt;br&gt;+ rent_id: int&lt;br&gt;+ old_end_date: Carbon&lt;br&gt;+ new_end_date: Carbon&lt;br&gt;+ additional_days: int&lt;br&gt;+ amount_due: int&lt;br&gt;+ payment_proof: string&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ rent(): BelongsTo&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="226" height="200" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:center;background:#e8eef7;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;extends Model&lt;/font&gt;&lt;br&gt;&lt;b&gt;Rent&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ id: int&lt;br&gt;+ ride_id: int&lt;br&gt;+ garage_id: int&lt;br&gt;+ rent_type: string&lt;br&gt;+ days: int&lt;br&gt;+ start_date: Carbon&lt;br&gt;+ end_date: Carbon&lt;br&gt;+ rent_fee: int&lt;br&gt;+ payment_proof: string&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ ride(): BelongsTo&lt;br&gt;+ garage(): BelongsTo&lt;br&gt;+ rentExtends(): HasMany&lt;br&gt;+ evCharges(): HasMany&lt;br&gt;+ isActiveToday(): bool&lt;br&gt;+ status(): string&lt;br&gt;+ canRequestCharge(): bool&lt;br&gt;+ nextBookingStart(): Carbon&lt;br&gt;+ totalDays(): int&lt;br&gt;+ totalPaid(): int&lt;br&gt;&lt;u&gt;+ maxDailyDays(start): int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ daysFor(rentType, start, days): int&lt;/u&gt;&lt;br&gt;&lt;u&gt;+ feeFor(rentType, days, garage): int&lt;/u&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="436" y="418" width="282" height="438" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;text-align:center;background:#e8eef7;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;extends Model&lt;/font&gt;&lt;br&gt;&lt;b&gt;EvCharge&lt;/b&gt