<mxfile host="app.diagrams.net"><diagram name="iGarage MVC Class Diagram" id="mvcfull"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1880" pageHeight="2162"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b0" value="&lt;div style=&quot;text-align:center;background:#d8c4ea;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;«layout»&lt;/font&gt;&lt;br&gt;&lt;b&gt;layouts.app / layouts.guest&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Blade layout + x- components&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace;min-height:6px&quot;&gt;- user: User&lt;br&gt;- menu: array (per role)&lt;br&gt;- flash: success | error&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ navigate(menuItem): GET&lt;br&gt;+ logout(): POST /logout&lt;br&gt;+ yield(content)&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;fillColor=#efe6f6;" vertex="1" parent="1"><mxGeometry x="124" y="86" width="385" height="174" as="geometry"/></mxCell><mxCell id="b1" value="&lt;div style=&quot;text-align:center;background:#d8c4ea;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;«view»&lt;/font&gt;&lt;br&gt;&lt;b&gt;AuthView&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;auth.login · auth.register · auth.verification&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace;min-height:6px&quot;&gt;- user: User&lt;br&gt;- errors: ViewErrorBag&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ submitLogin(email, password, remember)&lt;br&gt;+ submitRegister(nik, name, phone, email, password)&lt;br&gt;+ checkPasswordRules(): JS&lt;br&gt;+ autoReload(10 s): JS&lt;br&gt;+ logout()&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;fillColor=#efe6f6;" vertex="1" parent="1"><mxGeometry x="124" y="336" width="385" height="190" as="geometry"/></mxCell><mxCell id="b2" value="&lt;div style=&quot;text-align:center;background:#d8c4ea;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;«view»&lt;/font&gt;&lt;br&gt;&lt;b&gt;RenterView&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin.renters.index&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace;min-height:6px&quot;&gt;- renters: Paginator&amp;lt;User&amp;gt;&lt;br&gt;- status: string&lt;br&gt;- counts: Collection&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ filter(status): GET&lt;br&gt;+ approve(renter): PATCH&lt;br&gt;+ reject(renter): PATCH + confirm()&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;fillColor=#efe6f6;" vertex="1" parent="1"><mxGeometry x="124" y="696" width="385" height="174" as="geometry"/></mxCell><mxCell id="b3" value="&lt;div style=&quot;text-align:center;background:#d8c4ea;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;«view»&lt;/font&gt;&lt;br&gt;&lt;b&gt;GarageView&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;admin.garages.index · admin.garages.create&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace;min-height:6px&quot;&gt;- garages: Collection&amp;lt;Garage&amp;gt;&lt;br&gt;- statusCounts, typeCounts: Collection&lt;br&gt;- nextCodes: array&lt;