oller» auth&lt;/font&gt;&lt;br&gt;&lt;b&gt;HomeController&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace;min-height:6px&quot;&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ __invoke(Request): RedirectResponse&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="659" y="572" width="352" height="78" as="geometry"/></mxCell><mxCell id="b10" value="&lt;div style=&quot;text-align:center;background:#dae8fc;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;«controller» role:admin&lt;/font&gt;&lt;br&gt;&lt;b&gt;Admin\RenterController&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace;min-height:6px&quot;&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace&quot;&gt;+ index(Request): View&lt;br&gt;+ approve(User): RedirectResponse&lt;br&gt;+ reject(User): RedirectResponse&lt;br&gt;- decide(User, status, message): RedirectResponse&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=11;spacing=0;rounded=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="659" y="696" width="352" height="126" as="geometry"/></mxCell><mxCell id="b11" value="&lt;div style=&quot;text-align:center;background:#dae8fc;padding:4px;border-bottom:1px solid #333&quot;&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555&quot;&gt;«controller» role:admin&lt;/font&gt;&lt;br&gt;&lt;b&gt;Admin\GarageController&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:4px 8px;font-family:monospace;min-height:6px&quot;&gt;&lt;/div&gt;&lt;hr style=&quot;margin:0;border:0;border-top:1px solid #333&quot;&gt;&lt;div style=&