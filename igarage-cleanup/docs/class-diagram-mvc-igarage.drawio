id="l39" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e37"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e40" value="is rented in" style="endArrow=none;startArrow=none;html=1;rounded=0;fontStyle=2;" edge="1" parent="1" source="b20" target="b21"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="974" as="sourcePoint"/><mxPoint x="1400" y="1034" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l41" value="1" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e40"><mxGeometry x="-0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l42" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e40"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e43" value="is charged in" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;rounded=0;fontStyle=2;" edge="1" parent="1" source="b21" target="b22"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="1450" as="sourcePoint"/><mxPoint x="1400" y="1510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l44" value="1" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e43"><mxGeometry x="-0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l45" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e43"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e46" value="is extended by" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;rounded=0;fontStyle=2;" edge="1" parent="1" source="b21" target="b23"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="1390" as="sourcePoint"/><mxPoint x="1560" y="1906" as="targetPoint"/><Array as="points"><mxPoint x="1622" y="1390"/><mxPoint x="1622" y="1906"/></Array></mxGeometry></mxCell><mxCell id="l47" value="1" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e46"><mxGeometry x="-0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l48" value="0..*" style="edgeLabel;html=1;fontStyle=1;" vertex="1" connectable="0" parent="e46"><mxGeometry x="0.85" y="10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e49" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7bb36b;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b18" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e50" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7bb36b;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b19" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e51" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7bb36b;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b20" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e52" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7bb36b;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b21" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e53" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7bb36b;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b22" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e54" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7bb36b;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="b23" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="notes" value="Request flow: the user acts in a View → routes/web.php → middleware (auth, role, approved) → Controller → Model → MySQL, then the Controller returns a View or a redirect.&lt;br&gt;View ⇄ Controller: the view sends HTTP requests (its + methods are forms, links and buttons; JS = runs only in the browser) and the controller returns the view with the data in its - attributes.&lt;br&gt;Dashed arrow = dependency («use»): the controller or middleware uses that model. Solid line between models = association with multiplicity; ◆ = composition (deleted with its rent).&lt;br&gt;Every view extends a Blade layout (@extends). Models extend Eloquent Model (User extends Authenticatable) and are stored in MySQL. Underlined model methods are static." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2052" width="1800" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>