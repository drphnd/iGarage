charges"><mxGeometry y="118" width="330" height="22" as="geometry"/></mxCell><mxCell id="ev_charges_5" value="fee : int unsigned" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;" vertex="1" parent="ev_charges"><mxGeometry y="140" width="330" height="22" as="geometry"/></mxCell><mxCell id="ev_charges_6" value="payment_proof : varchar(255)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;" vertex="1" parent="ev_charges"><mxGeometry y="162" width="330" height="22" as="geometry"/></mxCell><mxCell id="ev_charges_7" value="created_at / updated_at : timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;" vertex="1" parent="ev_charges"><mxGeometry y="184" width="330" height="22" as="geometry"/></mxCell><mxCell id="rel0" value="owns" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="users_0" target="rides_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel1" value="is parked in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rides_0" target="rents_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel2" value="is rented in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="garages_0" target="rents_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel3" value="is extended by" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rents_0" target="rent_extends_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel4" value="is charged in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rents_0" target="ev_charges_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Cardinality: every relationship is 1 : N (one parent, zero or many children).&lt;br&gt;ON DELETE: users→rides, rides→rents, garages→rents = RESTRICT · rents→rent_extends, rents→ev_charges = CASCADE.&lt;br&gt;users.role: admin | renter · users.verification_status: pending | approved | rejected · rents.rent_type: daily | monthly&lt;br&gt;rides.type: bicycle | motorcycle | car | electric_car · garages.type: bicycle | car | electric&lt;br&gt;Garage status (available / booked / in use) is derived from rent dates. An extension updates rents.end_date and keeps history in rent_extends.&lt;br&gt;ev_charges: only for electric cars in electric garages; the first full charge is created together with the rent.&lt;br&gt;Fees and price_per_kwh are stored per transaction, so later garage price changes do not alter past records or reports.&lt;br&gt;users.email is saved in lowercase and rides.plate_number without spaces in uppercase, so the same email or vehicle is never stored twice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="845" width="1150" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>